# ==============================================================================
# BOOKINGGO SAAS - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Optimized for Dokploy Deployment with Nixpacks
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT=3000
HOSTNAME="0.0.0.0"
APP_NAME="BookingGo SaaS"
# Public URL of your deployed application (replace with your domain or Dokploy URL)
APP_URL="https://your-domain.com"
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Self-Hosted MongoDB)
# ------------------------------------------------------------------------------
# Replace with your actual MongoDB connection string:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/booking?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (NextAuth v5 / Auth.js)
# ------------------------------------------------------------------------------
# Generate a secure 32-byte secret: openssl rand -base64 32
AUTH_SECRET="your-generated-random-32-byte-secret-key-here"
NEXTAUTH_SECRET="your-generated-random-32-byte-secret-key-here"

# CRITICAL FOR DOKPLOY: Trust the reverse proxy (Dokploy Traefik / Nginx)
AUTH_TRUST_HOST=true

# Canonical URL used by NextAuth for callbacks and redirects
NEXTAUTH_URL="https://your-domain.com"

# ------------------------------------------------------------------------------
# 4. STRIPE PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Secret key from your Stripe Dashboard (Developers > API keys)
STRIPE_SECRET_KEY="sk_live_..."
# Webhook signing secret (Developers > Webhooks > Endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET="whsec_..."
# Client-side publishable key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# ------------------------------------------------------------------------------
# 5. PAYPAL PAYMENT GATEWAY (Optional)
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET_KEY=""
PAYPAL_MODE="live" # "sandbox" or "live"

# ------------------------------------------------------------------------------
# 6. EMAIL ENGINE & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Used for booking confirmations, cancellations, reminders, and verification
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_FROM_EMAIL="notifications@yourdomain.com"
SMTP_FROM_NAME="BookingGo Platform"

# ------------------------------------------------------------------------------
# 7. AUTOMATED SCHEDULED TASKS & CRON REMINDERS
# ------------------------------------------------------------------------------
# Secret bearer token to secure GET /api/cron/reminders
CRON_SECRET="generate-a-secure-random-cron-secret-token"

# ------------------------------------------------------------------------------
# 8. DEFAULT PLATFORM OFFLINE BANK DETAILS (Super Admin Fallback)
# ------------------------------------------------------------------------------
BANK_NAME="Silicon Valley Bank"
BANK_ACCOUNT_HOLDER="BookingGo Inc"
BANK_ACCOUNT_NUMBER="1234567890"
BANK_ROUTING_NUMBER="021000021"
BANK_SWIFT="SVBUS6S"

# ------------------------------------------------------------------------------
# 9. CLOUD STORAGE (AWS S3 / Wasabi / MinIO) - (Optional, defaults to local)
# ------------------------------------------------------------------------------
STORAGE_TYPE="local" # "local" or "s3"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_BUCKET=""

# ------------------------------------------------------------------------------
# 10. REAL-TIME NOTIFICATIONS (Pusher) - (Optional)
# ------------------------------------------------------------------------------
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_CLUSTER="mt1"
